rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica se o usuário é admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is list &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.hasAny(['admin'])
          )
        );
    }

    // Verifica se o usuário é médico ou admin
    function isDoctor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'admin'] ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is list &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.hasAny(['doctor', 'admin'])
          )
        );
    }

    // Verifica se o usuário está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Acesso universal para administradores
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Coleção de usuários
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if (isAuth() && request.auth.uid == userId) || isDoctor();
    }

    // Gestações — médico tem acesso total, mãe lê/atualiza a própria (pelo UID ou Email)
    match /pregnancies/{pregnancyId} {
      allow read, write: if isDoctor();
      allow read: if isAuth() && (resource.data.motherId == request.auth.uid || resource.data.motherEmail == request.auth.token.email);
      allow create: if isAuth() && request.resource.data.motherId == request.auth.uid;
      allow update: if isAuth() && 
        (resource.data.motherId == request.auth.uid || resource.data.motherEmail == request.auth.token.email) &&
        request.resource.data.motherId == request.auth.uid;
    }

    // Consultas — médico escreve, autenticado lê
    match /consultations/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Exames — médico escreve, autenticado lê
    match /exams/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Ultrassonografias — médico escreve, autenticado lê
    match /ultrasounds/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Medicamentos — médico escreve, autenticado lê
    match /medications/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Prescrições — médico escreve, autenticado lê
    match /prescriptions/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Documentos médicos — médico escreve, autenticado lê
    match /documents/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Notificações — usuário lê/atualiza as próprias; médico cria para qualquer um
    match /notifications/{id} {
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isDoctor() || (isAuth() && request.resource.data.userId == request.auth.uid);
    }

    // Eventos da timeline — médico escreve, autenticado lê
    match /timeline_events/{id} {
      allow read: if isAuth();
      allow write: if isDoctor();
    }

    // Logs de auditoria — médico lê, autenticado cria
    match /audit_logs/{id} {
      allow read: if isDoctor();
      allow create: if isAuth();
    }

    // Configurações do sistema (como horários de agendamento)
    match /settings/{id} {
      allow read: if true; // Qualquer um pode ler configurações (horários disponíveis)
      allow write: if isDoctor();
    }

    // Solicitações de agendamentos
    match /appointments/{id} {
      allow create: if true; // Qualquer pessoa pode pedir agendamento
      allow read, update, delete: if isDoctor();
    }
  }
}
